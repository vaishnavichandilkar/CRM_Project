// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model PasswordResetRequest {
  id                String    @id @default(cuid())
  userId            Int       @map("user_id")
  email             String
  requestedPassword String    @map("requested_password")
  status            String    @default("PENDING")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_requests")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  roles       RolePermission[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String     @unique
  password  String     @map("password_hash")
  roleId    Int        @map("role_id")
  role      Role       @relation(fields: [roleId], references: [id])
  status    UserStatus @default(ACTIVE)
  region    Region?
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  
  resetRequests PasswordResetRequest[]

  @@map("users")
}

enum ProductStatus {
  ACTIVE       @map("Active")
  OUT_OF_STOCK @map("Out of Stock")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  sku           String        @unique
  categoryId    Int           @map("category_id")
  category      Category      @relation(fields: [categoryId], references: [id])
  price         Float
  stockQuantity Int           @default(0) @map("stock_quantity")
  description   String?
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("products")
}

enum Region {
  NORTH @map("North")
  SOUTH @map("South")
  EAST  @map("East")
  WEST  @map("West")
}

model Dealer {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String   @map("contact_person")
  phone         String
  region        Region?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("dealers")
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String   @map("contact_person")
  phone         String
  productType   String   @map("product_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model VetDoc {
  id         Int      @id @default(autoincrement())
  doctorName String   @map("doctor_name")
  specialty  String
  phone      String
  region     Region?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("vet_docs")
}


model SHG {
  id              Int      @id @default(autoincrement())
  groupName       String   @map("group_name")
  leaderName      String   @map("leader_name")
  numberOfMembers Int      @map("number_of_members")
  region          Region?
  activity        String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shg")
}


enum VehicleType {
  TRUCK @map("Truck")
  VAN   @map("Van")
  BIKE  @map("Bike")
  OTHER @map("Other")
}

model Transporter {
  id            Int          @id @default(autoincrement())
  name          String
  contactPerson String       @map("contact_person")
  phone         String
  vehicleType   VehicleType? @map("vehicle_type")
  region        Region?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("transporters")
}

enum Platform {
  FACEBOOK  @map("Facebook")
  INSTAGRAM @map("Instagram")
  LINKEDIN  @map("LinkedIn")
  TWITTER   @map("Twitter")
  YOUTUBE   @map("YouTube")
}

model ContentPlan {
  id            Int       @id @default(autoincrement())
  campaignTitle String    @map("campaign_title")
  platform      Platform?
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("content_plans")
}

enum DesignType {
  BANNER         @map("Banner")
  FLYER          @map("Flyer")
  SOCIAL_POST    @map("Social Post")
  EMAIL_TEMPLATE @map("Email Template")
  POSTER         @map("Poster")
}

enum DesignStatus {
  DRAFT     @map("Draft")
  APPROVED  @map("Approved")
  IN_REVIEW @map("In Review")
}

model PromotionDesign {
  id          Int          @id @default(autoincrement())
  designTitle String       @map("design_title")
  type        DesignType?
  status      DesignStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("promotion_designs")
}

enum CustomerType {
  RETAIL    @map("Retail")
  WHOLESALE @map("Wholesale")
}

model Customer {
  id        Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  phone     String
  region    Region
  type      CustomerType
  address   String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("customers")
}
