// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model PasswordResetRequest {
  id                String    @id @default(cuid())
  userId            Int       @map("user_id")
  email             String
  requestedPassword String    @map("requested_password")
  status            String    @default("PENDING")
  requestedAt       DateTime  @default(now()) @map("requested_at")
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_requests")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  roles       RolePermission[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id        Int        @id @default(autoincrement())
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String     @unique
  password  String     @map("password_hash")
  roleId    Int        @map("role_id")
  role      Role       @relation(fields: [roleId], references: [id])
  status    UserStatus @default(ACTIVE)
  region    Region?
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  
  resetRequests     PasswordResetRequest[]
  modulePreferences UserModulePreference?
  customModules     CustomModule[]
  assignedLeads     Lead[]           @relation("AssignedLeads")
  calls             Call[]
  leadHistoryChanges LeadHistory[]

  @@map("users")
}

enum LeadSource {
  META_ADS    @map("Meta Ads")
  GOOGLE_ADS  @map("Google Ads")
  REFERRAL    @map("Referral")
  WEBSITE     @map("Website")
  OTHER       @map("Other")
}

enum LeadStatus {
  OPEN        @map("Open")
  IN_PROGRESS @map("In Progress")
  WON         @map("Won")
  LOST        @map("Lost")
}

model Lead {
  id           Int           @id @default(autoincrement())
  leadNumber   String?       @map("lead_number")
  customerId   Int?          @map("customer_id")
  customer     MasterData?   @relation("LeadCustomer", fields: [customerId], references: [id])
  productId    Int?          @map("product_id")
  product      MasterData?   @relation("LeadProduct", fields: [productId], references: [id])
  assignedToId Int?          @map("assigned_to_id")
  assignedTo   User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  status       LeadStatus    @default(OPEN)
  source       LeadSource    @default(OTHER)
  notes        String?
  isConverted  Boolean       @default(false) @map("is_converted")

  // Customer Details (Autofilled & Editable)
  customerName    String?    @map("customer_name")
  mobileNumber    String?    @map("mobile_number")
  alternateMobile String?    @map("alternate_mobile")
  email           String?
  gstNumber       String?    @map("gst_number")
  companyName     String?    @map("company_name")
  address         String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  customerType    String?    @map("customer_type")
  contactPerson   String?    @map("contact_person")
  customerData    Json?      @map("customer_data")

  // Product Details (Autofilled & Editable)
  productName     String?    @map("product_name")
  productCode     String?    @map("product_code")
  category        String?
  brand           String?
  unit            String?
  price           Float?
  tax             Float?
  stockQuantity   Int?       @map("stock_quantity")
  description     String?
  productData     Json?      @map("product_data")
  
  // Custom Lead Data (for dynamically managed Lead columns)
  leadData        Json?      @map("lead_data")

  tasks           Task[]
  calls           Call[]
  followups       LeadFollowup[]
  history         LeadHistory[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("leads")
}

enum TaskPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")
}

enum TaskStatus {
  TODO        @map("To Do")
  IN_PROGRESS @map("In Progress")
  COMPLETED   @map("Completed")
}

model Task {
  id          Int          @id @default(autoincrement())
  subject     String
  dueDate     DateTime     @map("due_date")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  description String?
  leadId      Int          @map("lead_id")
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("tasks")
}

enum CallType {
  INBOUND  @map("Inbound")
  OUTBOUND @map("Outbound")
}

model Call {
  id                Int       @id @default(autoincrement())
  callType          CallType  @map("call_type")
  startTime         DateTime  @map("start_time")
  duration          Int?      // in seconds
  voiceRecordingUrl String?   @map("voice_recording_url")
  notes             String?
  leadId            Int       @map("lead_id")
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId           Int       @map("owner_id")
  owner             User      @relation(fields: [ownerId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("calls")
}

model LeadHistory {
  id          Int        @id @default(autoincrement())
  leadId      Int        @map("lead_id")
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus   LeadStatus @map("old_status")
  newStatus   LeadStatus @map("new_status")
  changedById Int        @map("changed_by_id")
  changedBy   User       @relation(fields: [changedById], references: [id])
  remarks     String?    @map("remarks")
  timestamp   DateTime   @default(now()) @map("timestamp")

  @@map("lead_histories")
}

model LeadFollowup {
  id               Int          @id @default(autoincrement())
  leadId           Int          @map("lead_id")
  lead             Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callDate         DateTime     @map("call_date")
  callTime         String       @map("call_time")
  callType         String       @map("call_type") // Incoming, Outgoing, Meeting, Demo
  conversation     String
  nextFollowupDate DateTime?    @map("next_followup_date")
  status           String       @default("PENDING")
  assignedEmployee String?      @map("assigned_employee")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("lead_followups")
}

model CustomModule {
  id          Int                @id @default(autoincrement())
  name        String
  icon        String
  description String?
  allowView   Boolean            @default(true) @map("allow_view")
  allowEdit   Boolean            @default(true) @map("allow_edit")
  allowDelete Boolean            @default(true) @map("allow_delete")
  userId      Int                @map("user_id")
  user        User               @relation(fields: [userId], references: [id])
  fields      CustomField[]
  records     CustomModuleData[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("custom_modules")
}

model CustomField {
  id             Int          @id @default(autoincrement())
  customModuleId Int          @map("custom_module_id")
  customModule   CustomModule @relation(fields: [customModuleId], references: [id], onDelete: Cascade)
  name           String
  dataType       String       // e.g., "string", "number", "date"
  validationRules Json?        // e.g., { required: true, min: 0 }
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("custom_fields")
}

model CustomModuleData {
  id             Int          @id @default(autoincrement())
  customModuleId Int          @map("custom_module_id")
  customModule   CustomModule @relation(fields: [customModuleId], references: [id], onDelete: Cascade)
  data           Json         // The actual record data
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("custom_module_data")
}


enum ProductStatus {
  ACTIVE       @map("Active")
  OUT_OF_STOCK @map("Out of Stock")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  sku           String        @unique
  categoryId    Int           @map("category_id")
  category      Category      @relation(fields: [categoryId], references: [id])
  price         Float
  stockQuantity Int           @default(0) @map("stock_quantity")
  description   String?
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("products")
}

enum Region {
  NORTH @map("North")
  SOUTH @map("South")
  EAST  @map("East")
  WEST  @map("West")
}

model Dealer {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String   @map("contact_person")
  phone         String
  region        Region?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("dealers")
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String
  contactPerson String   @map("contact_person")
  phone         String
  productType   String   @map("product_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model VetDoc {
  id         Int      @id @default(autoincrement())
  doctorName String   @map("doctor_name")
  specialty  String
  phone      String
  region     Region?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("vet_docs")
}


model SHG {
  id              Int      @id @default(autoincrement())
  groupName       String   @map("group_name")
  leaderName      String   @map("leader_name")
  numberOfMembers Int      @map("number_of_members")
  region          Region?
  activity        String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shg")
}


enum VehicleType {
  TRUCK @map("Truck")
  VAN   @map("Van")
  BIKE  @map("Bike")
  OTHER @map("Other")
}

model Transporter {
  id            Int          @id @default(autoincrement())
  name          String
  contactPerson String       @map("contact_person")
  phone         String
  vehicleType   VehicleType? @map("vehicle_type")
  region        Region?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("transporters")
}

enum Platform {
  FACEBOOK  @map("Facebook")
  INSTAGRAM @map("Instagram")
  LINKEDIN  @map("LinkedIn")
  TWITTER   @map("Twitter")
  YOUTUBE   @map("YouTube")
}

model ContentPlan {
  id            Int       @id @default(autoincrement())
  campaignTitle String    @map("campaign_title")
  platform      Platform?
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("content_plans")
}

enum DesignType {
  BANNER         @map("Banner")
  FLYER          @map("Flyer")
  SOCIAL_POST    @map("Social Post")
  EMAIL_TEMPLATE @map("Email Template")
  POSTER         @map("Poster")
}

enum DesignStatus {
  DRAFT     @map("Draft")
  APPROVED  @map("Approved")
  IN_REVIEW @map("In Review")
}

model PromotionDesign {
  id          Int          @id @default(autoincrement())
  designTitle String       @map("design_title")
  type        DesignType?
  status      DesignStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("promotion_designs")
}

enum CustomerType {
  RETAIL    @map("Retail")
  WHOLESALE @map("Wholesale")
}

model Customer {
  id        Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  phone     String
  region    Region
  type      CustomerType
  address   String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("customers")
}

model MasterConfig {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  slug       String       @unique
  config     Json         // Array of { label, key, dataType, validationRules, options }
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  records    MasterData[]

  @@map("master_configs")
}

model MasterData {
  id             Int          @id @default(autoincrement())
  masterConfigId Int          @map("master_config_id")
  masterConfig   MasterConfig @relation(fields: [masterConfigId], references: [id])
  data           Json         // Actual record data
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  leadsAsCustomer Lead[] @relation("LeadCustomer")
  leadsAsProduct  Lead[] @relation("LeadProduct")

  salesAsCustomer Sale[] @relation("SaleCustomer")
  salesAsProduct  Sale[] @relation("SaleProduct")

  @@map("master_data")
}

model UserModulePreference {
  id              String   @id @default(uuid())
  userId          Int      @unique @map("user_id")
  selectedModules Json     @map("selected_modules")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_module_preferences")
}

enum SaleStatusEnum {
  Lead        @map("Lead")
  Opportunity @map("Opportunity")
  Sale        @map("Sale")
  Invoice     @map("Invoice")
}

model Sale {
  id            Int            @id @default(autoincrement())
  amount        Float
  status        SaleStatusEnum @default(Sale)
  date          DateTime       @default(now())
  purchaseCount Int            @default(1) @map("purchase_count")
  
  customerId    Int            @map("customer_id")
  customer      MasterData     @relation("SaleCustomer", fields: [customerId], references: [id])
  
  productId     Int            @map("product_id")
  product       MasterData     @relation("SaleProduct", fields: [productId], references: [id])
  
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("sales")
}
